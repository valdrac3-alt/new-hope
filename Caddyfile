{
    admin off
    auto_https off
}

:8080 {
    root * /app

    # Compress everything — zstd first (faster), gzip as fallback
    encode {
        zstd
        gzip 6
        minimum_length 512
    }

    # Bootstrap + fonts — bundled at build time, never change → 1 year
    @immutable {
        path *.woff *.woff2 *.ttf *.eot
    }
    handle @immutable {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    @bootstrap {
        path /assets/css/bootstrap* /assets/js/bootstrap*
    }
    handle @bootstrap {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Your own CSS/JS — 7 days (refreshes on redeploy)
    @static {
        path *.css *.js
    }
    handle @static {
        header Cache-Control "public, max-age=604800, must-revalidate"
        file_server
    }

    # Images
    @images {
        path *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp
    }
    handle @images {
        header Cache-Control "public, max-age=86400"
        file_server
    }

    php_server
}
