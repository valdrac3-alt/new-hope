# ============================================================
# .env — Copy this to .env and fill in your MySQL credentials
# ============================================================

# ── MySQL (Laragon / XAMPP local defaults shown) ───────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cap
DB_USER=root
DB_PASS=

# ── App Settings ──────────────────────────────────────────────
APP_NAME=Dental Clinic Management System
APP_DEBUG=false
BASE_URL=http://localhost/cap/

# ── OTP / Email (Resend — free at resend.com) ─────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=DentalCare

# ── OTP / SMS (Semaphore — Philippine SMS API) ────────────────
SEMAPHORE_API_KEY=

# ── hCaptcha (optional — leave blank to disable) ─────────────
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
