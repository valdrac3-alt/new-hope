# ============================================================
# .env — Copy this to .env and fill in your Supabase credentials
# ============================================================

# ── Supabase / PostgreSQL ─────────────────────────────────────
# Find these at: Supabase Dashboard → Settings → Database → Connection string
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your-supabase-database-password

# ── App Settings ──────────────────────────────────────────────
APP_NAME=Dental Clinic Management System
APP_DEBUG=false
BASE_URL=https://your-domain.com/

# ── OTP / Email (Resend — free at resend.com) ─────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=DentalCare

# ── OTP / SMS (Semaphore — Philippine SMS API) ────────────────
SEMAPHORE_API_KEY=

# ── hCaptcha (optional — leave blank to disable) ─────────────
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
